# Copy to .env and fill in the two REQUIRED values before `docker compose up`.

# SearXNG
SEARXNG_VERSION=latest
# REQUIRED. Generate with: openssl rand -hex 32
SEARXNG_SECRET=
# 127.0.0.1 = only reachable from this VM. Set to the VM's private IP to let a
# crawler on another machine connect (and firewall that port to the crawler).
SEARXNG_HOST=127.0.0.1
SEARXNG_PORT=8080

# Camoufox websocket server
# Same rule as SEARXNG_HOST.
CAMOUFOX_HOST=127.0.0.1
CAMOUFOX_PORT=9222
# REQUIRED. Acts as the access token for the browser. Generate with: openssl rand -hex 24
CAMOUFOX_WS_PATH=
CAMOUFOX_HEADLESS=true
